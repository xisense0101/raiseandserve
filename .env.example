# Copy to .env.local for development and set the same keys in Vercel.

# ── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TO_EMAIL=

# ── Cloudflare Turnstile ────────────────────────────────────────
# Dashboard → Turnstile → Add widget (mode: Managed). Add riseandserve.org,
# www.riseandserve.org and localhost as hostnames.
# Without these, forms work in development (verification skipped) but are
# rejected in production (fail closed).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cloudinary ──────────────────────────────────────────────────
# Only the cloud name is needed in the browser. The API key/secret are only
# needed by upload scripts and must never be exposed with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
